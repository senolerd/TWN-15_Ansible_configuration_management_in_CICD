def utils
pipeline {
    agent any 
    environment{
        SUBDIR = "50-Ansible_integration_in_Jenkins"
    }
    stages {
        stage('__init__') {
            steps {
                script {
                    utils = load "${env.SUBDIR}/utils.groovy"
                    // utils.getAnsibleServerIp()
                    env.ANSIBLE_SERVER = utils.getAnsibleServerIp()
                    echo ANSIBLE_SERVER
                }
                sshagent(credentials: ['devops_ssh_priv'], executable: '') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'devops_ssh_priv', keyFileVariable: 'rsa_key')]) {
                        sh 'scp $rsa_key ubuntu@$ANSIBLE_SERVER:~/'
                        sh 'ssh ubuntu@$ANSIBLE_SERVER ls'  
                    }
                }
            }
        }
    }
}
