def utils
pipeline {
    agent any 
    environment{
        PROJECT_DIR = "50-Ansible_integration_in_Jenkins"
    }
    stages {
        stage('__init__') {
            steps {
                script {
                    utils = load "${env.PROJECT_DIR}/utils.groovy"
                    // utils.getAnsibleServerIp()
                    env.ANSIBLE_SERVER = utils.getAnsibleServerIp()
                    echo ANSIBLE_SERVER
                }
            }
        }

        stage('Preparing Ansible Controller ') {
            steps {
                script{
                    utils.copyConfigsToAnsibleController()
                }
            }
        }

        stage('Running playbook for Workstations') {
            steps{
                script{
                    utils.runAnsiblePlaybook()
                }
            }
        }
    }

}
